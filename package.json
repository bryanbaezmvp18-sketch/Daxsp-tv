{
  "name": "daxsp-tv",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "dev:emuladores": "node scripts/dev-emuladores.mjs",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "emuladores": "firebase emulators:start --project demo-daxsp --only auth,firestore,storage",
