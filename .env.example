# Copia este archivo como .env.local y rellena los valores.
# NUNCA subas .env.local a git.

# ── Firebase (cliente, públicas) ─────────────────────────────
# Consola Firebase → Configuración del proyecto → Tus apps → Web
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=tu-proyecto.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=tu-proyecto
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=tu-proyecto.firebasestorage.app
NEXT_PUBLIC_FIREBASE_APP_ID=

# ── Firebase Admin (servidor, SECRETAS) ──────────────────────
# Configuración del proyecto → Cuentas de servicio → Generar nueva clave privada
FIREBASE_PROJECT_ID=tu-proyecto
FIREBASE_STORAGE_BUCKET=tu-proyecto.firebasestorage.app
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@tu-proyecto.iam.gserviceaccount.com
# Pega la clave entre comillas, con los \n tal cual
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# ── Sitio ────────────────────────────────────────────────────
# URL pública (se usa en los enlaces de acceso que reciben los alumnos)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ── Correos (Resend) ─────────────────────────────────────────
# Sin RESEND_API_KEY la web funciona igual, pero no envía correos (usa WhatsApp)
RESEND_API_KEY=
CORREO_REMITENTE="Daxsp TV <hola@tudominio.com>"
# Tu correo: aquí llegan los avisos de nuevas transferencias
ADMIN_EMAIL=

# ── Emuladores locales (opcional, solo desarrollo) ───────────
NEXT_PUBLIC_USE_EMULATORS=false
# FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099
# FIRESTORE_EMULATOR_HOST=127.0.0.1:8080
# FIREBASE_STORAGE_EMULATOR_HOST=127.0.0.1:9199
# Secreto para las URLs temporales locales (cualquier texto largo)
# ARCHIVOS_SECRETO=

# ── PayPal (tarjeta de crédito/débito y PayPal) ──────────────
# developer.paypal.com → Apps & Credentials. Usa "sandbox" para pruebas y "live" en producción.
PAYPAL_ENV=sandbox
NEXT_PUBLIC_PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
# ID del webhook (evento PAYMENT.CAPTURE.COMPLETED → https://tudominio.com/api/paypal/webhook)
PAYPAL_WEBHOOK_ID=
