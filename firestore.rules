rules_version = '2';

// Casi todo lo lee y escribe el servidor con el Admin SDK (que ignora estas reglas).
// El navegador solo puede LEER lo suyo (para ver su estado en tiempo real).
// Nadie puede escribir desde el navegador: ni su estado de compra ni sus pedidos.
service cloud.firestore {
  match /databases/{database}/documents {

    function autenticado() { return request.auth != null; }
    function esAdmin() { return autenticado() && request.auth.token.admin == true; }

    // Cuenta del cliente: solo él (o un admin) la lee. Nadie la modifica desde el navegador.
    match /usuarios/{uid} {
      allow read: if (autenticado() && request.auth.uid == uid) || esAdmin();
      allow write: if false;
    }

    // Pedidos: el cliente solo lee los suyos.
    match /pedidos/{pedidoId} {
      allow read: if (autenticado() && resource.data.uid == request.auth.uid) || esAdmin();
      allow write: if false;
    }

    // Todo lo demás: cerrado (solo admin puede leer).
    match /{document=**} {
      allow read: if esAdmin();
      allow write: if false;
    }
  }
}
